#!/bin/sh
### BEGIN INIT INFO
# Provides:          soundtouchd
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: On-device SoundTouch internet-radio controller
### END INIT INFO

NAME=soundtouchd
DAEMON=/opt/soundtouchd/soundtouchd
CONFIG=/mnt/nv/soundtouchd/config.json
PIDFILE=/var/run/$NAME.pid
LOG=/tmp/$NAME.log

start() {
    echo "Starting $NAME"
    # Wrap in `sh -c exec` so the daemon inherits the log redirect (start-stop-daemon
    # -b otherwise sends the child's stdio to /dev/null). exec makes the pidfile
    # point at the daemon itself.
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- -c "exec $DAEMON -config $CONFIG >>$LOG 2>&1"
}

# SIGTERM makes the daemon drain in-flight requests (up to 5s, shutdownGrace in
# main.go), so wait for it to actually exit: a restart that starts the new
# instance while the old one still holds the port would fail to bind. BusyBox
# start-stop-daemon has no --retry, hence the loop. SIGKILL after 10s.
stop() {
    echo "Stopping $NAME"
    pid=$(cat "$PIDFILE" 2>/dev/null)
    start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
    if [ -n "$pid" ]; then
        n=0
        while kill -0 "$pid" 2>/dev/null && [ $n -lt 20 ]; do
            sleep 0.5
            n=$((n + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            echo "$NAME did not exit; killing"
            kill -9 "$pid" 2>/dev/null
            sleep 0.5
        fi
    fi
    rm -f "$PIDFILE"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  [ -f "$PIDFILE" ] && echo "$NAME running (pid $(cat "$PIDFILE"))" || echo "$NAME stopped" ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
